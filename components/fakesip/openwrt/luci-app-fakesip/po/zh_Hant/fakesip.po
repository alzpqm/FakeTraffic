msgid "Add at least one SIP URI for the custom profile."
msgstr "請為自訂設定檔新增至少一個 SIP URI。"

msgid "Advanced"
msgstr "進階"

msgid "All interfaces"
msgstr "所有介面"

msgid "Basic"
msgstr "基本設定"

msgid "China Mobile IMS"
msgstr "中國移動 IMS"

msgid "China Telecom IMS"
msgstr "中國電信 IMS"

msgid "China Unicom IMS"
msgstr "中國聯通 IMS"

msgid "Configuration"
msgstr "設定"

msgid "Custom SIP URI"
msgstr "自訂 SIP URI"

msgid "Disable dynamic TTL before disabling hop estimation."
msgstr "停用躍點估算前，請先停用動態 TTL。"

msgid "Disable hop estimation"
msgstr "停用躍點估算"

msgid "Disguise UDP traffic as SIP protocol traffic using Netfilter Queue."
msgstr "使用 Netfilter Queue 將 UDP 流量偽裝成 SIP 通訊協定流量。"

msgid "Dynamic TTL percent"
msgstr "動態 TTL 百分比"

msgid "Enable IPv4 or IPv6."
msgstr "請至少啟用 IPv4 或 IPv6。"

msgid "Enable inbound or outbound traffic."
msgstr "請至少啟用輸入或輸出流量。"

msgid "Enabled"
msgstr "啟用"

msgid "Enter a non-zero 32-bit decimal or hexadecimal value."
msgstr "請輸入非零的 32 位元十進位或十六進位值。"

msgid "Fake packet TTL"
msgstr "偽裝封包 TTL"

msgid "Fake packet repeats"
msgstr "偽裝封包重複次數"

msgid "FakeSIP did not start."
msgstr "FakeSIP 未能啟動。"

msgid "FakeSIP did not stop."
msgstr "FakeSIP 未能停止。"

msgid "FakeSIP is running."
msgstr "FakeSIP 正在執行。"

msgid "FakeSIP is stopped."
msgstr "FakeSIP 已停止。"

msgid "FakeSIP"
msgstr "FakeSIP"

msgid "Firewall mark mask"
msgstr "防火牆標記遮罩"

msgid "Firewall mark"
msgstr "防火牆標記"

msgid "IPv4"
msgstr "IPv4"

msgid "IPv6 companion networks that share the same PPP device are included automatically."
msgstr "共用相同 PPP 裝置的 IPv6 配套網路會自動納入。"

msgid "IPv6"
msgstr "IPv6"

msgid "Inbound traffic"
msgstr "輸入流量"

msgid "Interface names must use letters, digits, dot, underscore or hyphen and be at most 15 bytes."
msgstr "介面名稱只能使用英文字母、數字、句點、底線或連字號，且不得超過 15 位元組。"

msgid "Legacy combined"
msgstr "舊版合併模式"

msgid "Linux devices (advanced)"
msgstr "Linux 裝置（進階）"

msgid "Linux devices"
msgstr "Linux 裝置"

msgid "Log file"
msgstr "日誌檔案"

msgid "NFQUEUE number"
msgstr "NFQUEUE 編號"

msgid "OpenWrt networks (recommended)"
msgstr "OpenWrt 網路（建議）"

msgid "OpenWrt networks resolve to their active PPPoE devices automatically."
msgstr "OpenWrt 網路會自動解析到目前使用中的 PPPoE 裝置。"

msgid "Outbound traffic"
msgstr "輸出流量"

msgid "Payload file"
msgstr "Payload 檔案"

msgid "Payload"
msgstr "Payload"

msgid "Restart FakeSIP"
msgstr "重新啟動 FakeSIP"

msgid "Restart"
msgstr "重新啟動"

msgid "Rotate Chinese carrier IMS"
msgstr "輪替中國電信業者 IMS"

msgid "Rotate observed SIP/RCS 5260 (experimental)"
msgstr "輪替觀察到的 SIP/RCS 5260（實驗性）"

msgid "Running"
msgstr "執行中"

msgid "SIP URI"
msgstr "SIP URI"

msgid "SIP URIs must be at most 120 bytes."
msgstr "SIP URI 不得超過 120 位元組。"

msgid "SIP URIs must start with \"sip:\" and contain no whitespace."
msgstr "SIP URI 必須以「sip:」開頭，且不可包含空白字元。"

msgid "SIP camouflage profile"
msgstr "SIP 偽裝設定檔"

msgid "Select at least one Linux device."
msgstr "請至少選擇一個 Linux 裝置。"

msgid "Select at least one OpenWrt network or Linux device."
msgstr "請至少選擇一個 OpenWrt 網路或 Linux 裝置。"

msgid "Select at least one OpenWrt network."
msgstr "請至少選擇一個 OpenWrt 網路。"

msgid "Service command failed."
msgstr "服務命令執行失敗。"

msgid "Service command failed: %s"
msgstr "服務命令執行失敗：%s"

msgid "Service"
msgstr "服務"

msgid "Silent mode"
msgstr "靜默模式"

msgid "Skip firewall rules"
msgstr "略過防火牆規則"

msgid "Standard SIP"
msgstr "標準 SIP"

msgid "Start FakeSIP"
msgstr "啟動 FakeSIP"

msgid "Start"
msgstr "啟動"

msgid "Status"
msgstr "狀態"

msgid "Stop FakeSIP"
msgstr "停止 FakeSIP"

msgid "Stop"
msgstr "停止"

msgid "Stopped"
msgstr "已停止"

msgid "The firewall mark must be fully contained in the mask."
msgstr "防火牆標記必須完整包含在遮罩內。"

msgid "The path is too long."
msgstr "路徑過長。"

msgid "The service state could not be verified."
msgstr "無法驗證服務狀態。"

msgid "Traffic"
msgstr "流量"

msgid "Unknown"
msgstr "未知"

msgid "Use an absolute path."
msgstr "請使用絕對路徑。"

msgid "Use direct device names only for unusual or legacy configurations."
msgstr "只有特殊或舊版設定才需要直接填寫裝置名稱。"

msgid "Use iptables instead of nft"
msgstr "使用 iptables 取代 nftables"

msgid "WAN networks"
msgstr "WAN 網路"

msgid "WAN selection method"
msgstr "WAN 選擇方式"

msgid "Working..."
msgstr "處理中…"
