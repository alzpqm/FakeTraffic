START=99
STOP=10
USE_PROCD=1
# OpenWrt APK default hooks export pkgname and invoke init scripts before the
# package-specific hook. Installation must not enable/start us; removal is
# handled by our checked prerm, which unsets pkgname before its explicit stop.
if [ "${pkgname:-}" = faketraffic ]; then
    case "${action:-}" in start|enable|stop|disable|restart|reload) exit 0;; esac
fi
. /lib/functions.sh
. /lib/functions/network.sh
. /usr/libexec/faketraffic/runtime-manager.sh

append_flag()
{
	local section="$1"
	local option="$2"
	local flag="$3"
	local value

	config_get_bool value "$section" "$option" 0
	[ "$value" -eq 1 ] && procd_append_param command "$flag"
}

append_number()
{
	local section="$1"
	local option="$2"
	local flag="$3"
	local value

	config_get value "$section" "$option" "-1"
	[ "$value" -gt 0 ] 2>/dev/null && procd_append_param command "$flag" "$value"
}

append_queue_number()
{
	local value

	config_get value advanced queue_number "-1"
	[ "$value" -ge 0 ] 2>/dev/null &&
		[ "$value" -le 65535 ] 2>/dev/null &&
		procd_append_param command -n "$value"
}

append_bypass_port()
{
	local value="$1"

	[ "$value" -ge 1 ] 2>/dev/null &&
		[ "$value" -le 65535 ] 2>/dev/null &&
		procd_append_param command -p "$value"
}

append_interface()
{
	local value="$1"
	local dev

	[ -n "$value" ] || return 0

	if network_get_device dev "$value"; then
		value="$dev"
	fi

	procd_append_param command -i "$value"
	procd_append_param netdev "$value"
}

append_payload()
{
	local section="$1"
	local enabled type payload

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get type "$section" type ""
	config_get payload "$section" payload ""
	[ -n "$payload" ] || return 0

	case "$type" in
		http) procd_append_param command -h "$payload" ;;
		https) procd_append_param command -e "$payload" ;;
		binary) procd_append_param command -b "$payload" ;;
	esac
}

append_advanced()
{
	append_flag advanced skip -f
	append_flag advanced disable_estimation -g
	append_number advanced pct -y
	append_number advanced fwmark_bypassing -m
	append_number advanced fwmark_handle -x
	append_queue_number
	config_list_foreach advanced bypass_port append_bypass_port
	append_number advanced repeat -r
	append_number advanced ttl -t
	append_flag advanced use_iptables -z
}

start_tcp()
{
	local enabled

	config_get_bool enabled globals enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance tcp
	procd_set_param command /usr/libexec/faketraffic/lock-run tcp
	config_list_foreach globals interface append_interface
	append_flag globals silent -s
	config_foreach append_payload payload
	append_advanced
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_close_instance
}


append_bool_arg() {
	local section="$1"
	local option="$2"
	local flag="$3"
	local default="${4:-0}"
	local value

	config_get_bool value "$section" "$option" "$default"
	[ "$value" -eq 1 ] && procd_append_param command "$flag"
}

append_value_arg() {
	local section="$1"
	local option="$2"
	local flag="$3"
	local value

	config_get value "$section" "$option"
	[ -n "$value" ] && procd_append_param command "$flag" "$value"
}

append_nonzero_arg() {
	local section="$1"
	local option="$2"
	local flag="$3"
	local value

	config_get value "$section" "$option"
	[ -n "$value" ] && [ "$value" != "0" ] &&
		procd_append_param command "$flag" "$value"
}

append_list_arg() {
	local value="$1"
	local flag="$2"

	[ -n "$value" ] && procd_append_param command "$flag" "$value"
}

append_sip_payloads() {
	local section="$1"
	local profile

	config_get profile "$section" sip_profile standard
	case "$profile" in
		china_mobile)
			procd_append_param command -u \
				'sip:user@ims.mnc000.mcc460.3gppnetwork.org'
			;;
		china_unicom)
			procd_append_param command -u \
				'sip:user@ims.mnc001.mcc460.3gppnetwork.org'
			;;
		china_telecom)
			procd_append_param command -u \
				'sip:user@ims.mnc003.mcc460.3gppnetwork.org'
			;;
		china_all)
			procd_append_param command -u \
				'sip:user@ims.mnc000.mcc460.3gppnetwork.org'
			procd_append_param command -u \
				'sip:user@ims.mnc001.mcc460.3gppnetwork.org'
			procd_append_param command -u \
				'sip:user@ims.mnc003.mcc460.3gppnetwork.org'
			;;
		china_sip_observed)
			procd_append_param command -u \
				'sip:user@sipcq16.xnq.r.10086.cn:5260'
			procd_append_param command -u \
				'sip:user@sipsc109.r01.rcs.189.cn:5260'
			;;
		custom)
			config_list_foreach "$section" sip_uri append_list_arg -u
			;;
		standard|'')
			;;
		*)
			logger -t faketraffic "unknown SIP profile '$profile'"
			;;
	esac
}

append_interface_arg() {
	local device="$1"

	[ -n "$device" ] || return 0
	case "$device" in
		*[!A-Za-z0-9_.-]*|????????????????*)
			logger -t faketraffic "invalid interface '$device'"
			return 0
			;;
	esac

	case " $FS_IFACES_ADDED " in
		*" $device "*) return 0 ;;
	esac

	FS_IFACES_ADDED="$FS_IFACES_ADDED $device"
}

append_network_arg() {
	local network="$1"
	local device

	network_get_device device "$network" || {
		if [ -d "/sys/class/net/$network" ]; then
			append_interface_arg "$network"
		else
			logger -t faketraffic "network '$network' has no active device"
		fi
		return 0
	}

	append_interface_arg "$device"
}

has_list_values() {
	local section="$1"
	local option="$2"
	local values

	config_get values "$section" "$option"
	[ -n "$values" ]
}

start_udp() {
	local section="$1"
	local enabled all_interfaces interface_mode device log_file
	local inbound outbound ipv4 ipv6 sip_profile
	FS_IFACES_ADDED=

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get_bool inbound "$section" inbound 0
	config_get_bool outbound "$section" outbound 1
	if [ "$inbound" -ne 1 ] && [ "$outbound" -ne 1 ]; then
		logger -t faketraffic "section '$section' has no enabled traffic direction"
		return 0
	fi

	config_get_bool ipv4 "$section" ipv4 1
	config_get_bool ipv6 "$section" ipv6 1
	if [ "$ipv4" -ne 1 ] && [ "$ipv6" -ne 1 ]; then
		logger -t faketraffic "section '$section' has no enabled IP family"
		return 0
	fi

	config_get sip_profile "$section" sip_profile standard
	case "$sip_profile" in
		standard|''|china_mobile|china_unicom|china_telecom|china_all|china_sip_observed|custom)
			;;
		*)
			logger -t faketraffic "section '$section' has unknown SIP profile '$sip_profile'"
			return 0
			;;
	esac
	if [ "$sip_profile" = custom ] &&
	   ! has_list_values "$section" sip_uri; then
		logger -t faketraffic "section '$section' custom SIP profile has no URI"
		return 0
	fi

	config_get_bool all_interfaces "$section" all_interfaces 0
	config_get interface_mode "$section" interface_mode auto

	if [ "$all_interfaces" -ne 1 ]; then
		case "$interface_mode" in
			network)
				if ! has_list_values "$section" network; then
					logger -t faketraffic "section '$section' has no OpenWrt network"
					return 0
				fi
				config_list_foreach "$section" network append_network_arg
				;;
			device)
				if ! has_list_values "$section" interface; then
					logger -t faketraffic "section '$section' has no Linux device"
					return 0
				fi
				config_list_foreach "$section" interface append_interface_arg
				;;
			auto|'')
				if ! has_list_values "$section" network &&
				   ! has_list_values "$section" interface; then
					logger -t faketraffic "section '$section' has no network or interface"
					return 0
				fi
				config_list_foreach "$section" network append_network_arg
				config_list_foreach "$section" interface append_interface_arg
				;;
			*)
				logger -t faketraffic "section '$section' has invalid interface mode '$interface_mode'"
				return 0
				;;
		esac

		if [ -z "$FS_IFACES_ADDED" ]; then
			logger -t faketraffic "section '$section' has no usable interface"
			return 0
		fi
	fi

	procd_open_instance udp
	procd_set_param command /usr/libexec/faketraffic/lock-run udp

	append_bool_arg "$section" inbound -0 0
	append_bool_arg "$section" outbound -1 1
	append_bool_arg "$section" ipv4 -4 1
	append_bool_arg "$section" ipv6 -6 1
	append_bool_arg "$section" no_hop_estimate -g
	append_bool_arg "$section" skip_firewall -f
	append_bool_arg "$section" use_iptables -z
	append_bool_arg "$section" silent -s 1

	append_sip_payloads "$section"
	config_list_foreach "$section" payload_file append_list_arg -b

	append_value_arg "$section" queue_num -n
	append_value_arg "$section" fwmark -m
	append_value_arg "$section" fwmask -x
	append_value_arg "$section" repeat -r
	append_value_arg "$section" ttl -t
	append_nonzero_arg "$section" dynamic_pct -y

	if [ "$all_interfaces" -eq 1 ]; then
		procd_append_param command -a
	else
		for device in $FS_IFACES_ADDED; do
			procd_append_param command -i "$device"
		done
	fi

	config_get log_file "$section" log_file
	[ -n "$log_file" ] && procd_append_param command -w "$log_file"

	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}


# Never compete with a still-active/enabled legacy owner.
legacy_active() {
    local old
    for old in fakehttp fakesip fakeflow; do
        [ -x "/etc/init.d/$old" ] || continue
        if "/etc/init.d/$old" running >/dev/null 2>&1 ||
           "/etc/init.d/$old" enabled >/dev/null 2>&1; then
            logger -t faketraffic "legacy service $old must be stopped and disabled before migration"
            return 0
        fi
    done
    return 1
}

start_service() {
    local tcp_enabled udp_enabled backend
    legacy_active && return 1
    network_flush_cache
    config_load faketraffic
    config_get_bool tcp_enabled globals enabled 0
    config_get_bool udp_enabled main enabled 0
    prepare_runtime || return 1
    config_get backend globals backend nfqueue
    case "$backend" in
        ebpf)
            [ "$tcp_enabled" = 1 ] || [ "$udp_enabled" = 1 ] || return 0
            start_ebpf
            return $?
            ;;
        nfqueue) ;;
        *) logger -t faketraffic "unsupported backend"; return 1;;
    esac
    validate_nfqueue || return 1
    start_tcp
    start_udp main
    return 0
}

add_network_trigger() {
    [ -n "$1" ] && procd_add_interface_trigger "interface.*" "$1" /etc/init.d/faketraffic reload
}

service_triggers() {
    procd_add_reload_trigger faketraffic
    config_load faketraffic
    config_list_foreach globals interface add_network_trigger
    config_list_foreach main network add_network_trigger
}
# Reload re-submits definitions, so procd can preserve an unchanged engine.

# ubus running:true can precede exec and the engine's TERM handler. Starting
# and immediately stopping in that interval can lose TERM on this target.
# Only inspect our own service/PIDs; do not signal or wait on other services.
wait_instance_ready() {
    local tries=0 stable=0 previous= pids pid exe caught blocked ready reply service="${1:-faketraffic}" required="${2:-0}" tcp_wanted=0 udp_wanted=0 tcp_pid udp_pid ebpf_pid backend=nfqueue pause=sleep max_tries=5
    case "$service" in *[!A-Za-z0-9_]*|'') return 1;; esac
    if command -v usleep >/dev/null 2>&1; then pause=usleep; max_tries=50; fi
    if [ "$required" -eq 1 ]; then
        config_get_bool tcp_wanted globals enabled 0
        config_get_bool udp_wanted main enabled 0
        config_get backend globals backend nfqueue
    fi
    while [ "$tries" -lt "$max_tries" ]; do
        reply="$(ubus call service list "{\"name\":\"$service\"}" 2>/dev/null)" || return 1
        pids="$(printf '%s' "$reply" | jsonfilter -e "@.$service.instances.*.pid" 2>/dev/null)"
        ready=1
        if [ "$required" -eq 1 ]; then
            tcp_pid="$(printf '%s' "$reply" | jsonfilter -e "@.$service.instances.tcp.pid" 2>/dev/null)"
            udp_pid="$(printf '%s' "$reply" | jsonfilter -e "@.$service.instances.udp.pid" 2>/dev/null)"
            if [ "$backend" = ebpf ]; then
                ebpf_pid="$(printf '%s' "$reply" | jsonfilter -e "@.$service.instances.ebpf.pid" 2>/dev/null)"
                [ -z "$tcp_pid$udp_pid" ] || ready=0
                if [ "$tcp_wanted$udp_wanted" = 00 ]; then [ -z "$ebpf_pid" ] || ready=0; else [ -n "$ebpf_pid" ] || ready=0; fi
            else
                if [ "$tcp_wanted" -eq 1 ]; then [ -n "$tcp_pid" ] || ready=0; else [ -z "$tcp_pid" ] || ready=0; fi
                if [ "$udp_wanted" -eq 1 ]; then [ -n "$udp_pid" ] || ready=0; else [ -z "$udp_pid" ] || ready=0; fi
            fi
        elif [ -z "$pids" ]; then
            return 0
        fi
        for pid in $pids; do
            case "$pid" in *[!0-9]*|'') ready=0; continue;; esac
            exe="$(readlink "/proc/$pid/exe" 2>/dev/null)"
            case "$exe" in /usr/libexec/faketraffic/fakehttp|/usr/libexec/faketraffic/fakesip|/usr/libexec/faketraffic/ebpf) ;; *) ready=0; continue;; esac
            caught="$(awk '$1 == "SigCgt:" { print $2 }' "/proc/$pid/status" 2>/dev/null)"
            blocked="$(awk '$1 == "SigBlk:" { print $2 }' "/proc/$pid/status" 2>/dev/null)"
            case "$caught:$blocked" in *[!0-9a-fA-F:]*|:*|*:) ready=0; continue;; esac
            [ "$((0x$caught & 16384))" -ne 0 ] && [ "$((0x$blocked & 16384))" -eq 0 ] || ready=0
        done
        if [ "$ready" -eq 1 ] && [ "$pids" = "$previous" ]; then
            stable=$((stable + 1))
            [ "$stable" -ge 2 ] && return 0
        else
            stable=0
        fi
        previous="$pids"
        tries=$((tries + 1))
        if [ "$pause" = usleep ]; then usleep 100000 || return 1; else sleep 1 || return 1; fi
    done
    logger -t faketraffic "instance readiness timed out; not confirmed healthy"
    return 1
}

service_started() { config_load faketraffic; wait_instance_ready faketraffic 1; }
stop_service() { wait_instance_ready || return 0; }
reload_service() {
    wait_instance_ready || return 1
    reload_backend
}
